@page "{id:int}"
@model TicketSupportSystem.Pages.UserView.TicketViewerModel
@{
    ViewData["Title"] = "Ticket Details";
}
<div class="ticket-container">
    <h1>Ticket #@Model.ticket.TicketID: @Model.ticket.Subject</h1>
    
    <div class="ticket-body">
        <p><strong>Description:</strong> @Model.ticket.Description</p>
        <span class="badge">Status: @Model.ticket.Status</span>
        <span class="badge">Created At: @Model.ticket.CreatedAt</span>
    </div>
</div>